# Proveedor por defecto: 'ollama' o 'gemini'
AI_PROVIDER=ollama

# Configuración de Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
# Modelo RÁPIDO (sin razonamiento): responde en ~0.1-1.5 s en una RTX 4050 de 6 GB.
OLLAMA_MODEL=qwen3:4b-instruct
# Modelo para PENSAR A FONDO (matemáticas, lógica, depuración). Vacío = usar OLLAMA_MODEL.
# Ojo: "qwen3:4b" es la variante Thinking, que siempre razona; no sirve como modelo rápido.
# No caben ambos a la vez en 6 GB de VRAM: cambiar de uno a otro cuesta ~6-8 s.
# Alternativa más potente pero lenta (no cabe en la GPU): deepseek-r1:latest
OLLAMA_DEEP_MODEL=qwen3:4b

# Configuración de Google Gemini (Nube / Alternativo)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parámetros del agente
MAX_ITERATIONS=6
SEARCH_MAX_RESULTS=5

# Machine Learning (enrutador online + memoria semántica)
ML_ENABLED=true
# Si es true, EDITH activa Co-Working sola cuando la consulta es compleja
ML_AUTO_ROUTE=true
# Confianza mínima (0 a 1) para cambiar de ruta automáticamente
ML_AUTO_THRESHOLD=0.6

# Velocidad de Ollama
# Tiempo que el modelo se queda cargado en memoria entre mensajes (evita recargarlo cada vez)
OLLAMA_KEEP_ALIVE=30m
# Ventana de contexto. Solo el prompt de EDITH + herramientas ocupa ~4100 tokens: no bajes de 8192.
# Con qwen3:4b en una RTX 4050: 8192 = 63 tok/s, 100 % GPU (3.3 GB).
OLLAMA_NUM_CTX=8192
# Razonamiento: auto = EDITH decide por mensaje (rápido para charla, profundo para
# matemáticas/código/análisis), true = siempre razona, false = nunca razona.
# El modo profundo usa OLLAMA_DEEP_MODEL; el rápido, OLLAMA_MODEL.
OLLAMA_THINK=auto
# Precarga el modelo al abrir EDITH para que el primer mensaje no tarde
OLLAMA_WARMUP=true

# Obsidian: ruta de la bóveda donde EDITH escribe notas y sesiones
OBSIDIAN_VAULT_PATH=C:\Users\diego\Documents\EDITH_proyecto\EDITH_p
# true = cada conversación se guarda sola en "01 - Diario/" de la bóveda
OBSIDIAN_AUTO_SYNC=false

# Voz: usar voces de Windows (SAPI5) si no hay internet para edge-tts
VOICE_OFFLINE_FALLBACK=true

# ===== Canales remotos (Fases 9 y 10) =====
# Lista blanca OBLIGATORIA: solo estos números pueden hablar con EDITH por WhatsApp o teléfono.
# Vacía = nadie entra. Formato internacional separado por comas: +5215512345678,+5215587654321
AUTHORIZED_PHONE_NUMBERS=
# A quién avisa EDITH (WhatsApp y llamadas de alarma). Por defecto, el primer número autorizado.
OWNER_PHONE_NUMBER=
# Desde WhatsApp/teléfono EDITH NO ejecuta PowerShell, ni abre apps, ni ve la pantalla. true para permitirlo.
REMOTE_ALLOW_SYSTEM_TOOLS=false

# WhatsApp (bridge local con Baileys: bridges/whatsapp). Vincula un número SECUNDARIO.
WHATSAPP_ENABLED=false
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3100
# auto = contesta con nota de voz cuando tú mandas nota de voz | always | never
WHATSAPP_VOICE_REPLIES=auto
# Transcripción local (faster-whisper). Modelos: tiny, base, small, medium. "small" va bien en español.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Teléfono (Twilio Voice). En la consola de Twilio, el webhook del número debe apuntar a
#   {PUBLIC_BASE_URL}/api/voice/incoming  (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# URL pública HTTPS que llega a EDITH (Fase 8: Tailscale Funnel, Cloudflare Tunnel o ngrok)
PUBLIC_BASE_URL=
# gather = por turnos (funciona desde el primer día) | relay = tiempo real (requiere activar ConversationRelay)
TWILIO_VOICE_MODE=gather
TWILIO_LANGUAGE=es-MX
TWILIO_SAY_VOICE=Polly.Mia-Neural
TWILIO_RELAY_VOICE=

# ===== Autonomía proactiva (Fase 11) =====
HEARTBEAT_ENABLED=true
# Cada cuánto revisa salud de la laptop y tareas de Obsidian (los recordatorios se revisan cada minuto)
HEARTBEAT_MINUTES=15
# Resumen matutino (vacío = desactivado)
MORNING_BRIEFING_TIME=08:00
# De noche solo pasan los avisos críticos
QUIET_HOURS=23:00-07:00
# Minutos sin confirmar una alarma crítica antes de llamarte
ESCALATE_AFTER_MINUTES=10
# Temas de noticias para el resumen matutino, separados por comas (vacío = sin noticias)
HEARTBEAT_NEWS_TOPICS=
# Por dónde avisa: ui, toast, whatsapp
NOTIFY_CHANNELS=ui,toast,whatsapp

# ===== Seguridad de la interfaz y la API (Fase 14) =====
# La interfaz, la API (/api/*) y el chat (/ws/chat) exigen un token. Se genera solo en
# %LOCALAPPDATA%\EDITH\data\channels\api_token; ponlo aquí solo si quieres fijarlo tú (largo y aleatorio).
EDITH_API_TOKEN=
# Desde la propia máquina (http://localhost:8000) la interfaz entra sola. false = pedir siempre el enlace.
EDITH_LOCAL_AUTOLOGIN=true
# Nombres o IPs extra con los que llegas a EDITH desde otro dispositivo (Tailscale, red local), separados
# por comas. localhost y el host de PUBLIC_BASE_URL ya están permitidos. Enlace con token: Ajustes › Avanzado ›
# «Copiar enlace para otro dispositivo», EDITH.exe --access-link o, desde el código, python main.py --access-link
EDITH_ALLOWED_HOSTS=
