# Proveedor por defecto: 'ollama' o 'gemini'
AI_PROVIDER=ollama

# Configuración de Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
# Modelos sugeridos: deepseek-r1:latest, deepseek-r1:8b, deepseek-r1:1.5b, llama3.2:latest, qwen2.5:7b
OLLAMA_MODEL=deepseek-r1:latest

# Configuración de Google Gemini (Nube / Alternativo)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parámetros del agente
MAX_ITERATIONS=6
SEARCH_MAX_RESULTS=5

# Machine Learning (enrutador online + memoria semántica)
ML_ENABLED=true
# Si es true, EDITH activa Co-Working sola cuando la consulta es compleja
ML_AUTO_ROUTE=true
# Confianza mínima (0 a 1) para cambiar de ruta automáticamente
ML_AUTO_THRESHOLD=0.6

# Velocidad de Ollama
# Tiempo que el modelo se queda cargado en memoria entre mensajes (evita recargarlo cada vez)
OLLAMA_KEEP_ALIVE=30m
# Ventana de contexto. En una GPU de 6 GB: 4096 = 17.7 tok/s, 8192 = 14.7 tok/s (medido en RTX 4050)
OLLAMA_NUM_CTX=4096
# false = respuestas directas sin bloque <think> (mucho más rápidas) en modelos que lo permiten
# (qwen3, deepseek-v3.1...). Ojo: deepseek-r1:8b lo ignora y siempre razona.
OLLAMA_THINK=true
# Precarga el modelo al abrir EDITH para que el primer mensaje no tarde
OLLAMA_WARMUP=true

# Obsidian: ruta de la bóveda donde EDITH escribe notas y sesiones
OBSIDIAN_VAULT_PATH=C:\Users\diego\Documents\EDITH_proyecto\EDITH_p
# true = cada conversación se guarda sola en "01 - Diario/" de la bóveda
OBSIDIAN_AUTO_SYNC=false

# Voz: usar voces de Windows (SAPI5) si no hay internet para edge-tts
VOICE_OFFLINE_FALLBACK=true
