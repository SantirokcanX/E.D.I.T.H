# Proveedor por defecto: 'ollama' o 'gemini'
AI_PROVIDER=ollama

# Configuración de Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
# Modelos sugeridos: deepseek-r1:latest, deepseek-r1:8b, deepseek-r1:1.5b, llama3.2:latest, qwen2.5:7b
OLLAMA_MODEL=deepseek-r1:latest

# Configuración de Google Gemini (Nube / Alternativo)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parámetros del agente
MAX_ITERATIONS=6
SEARCH_MAX_RESULTS=5

# Machine Learning (enrutador online + memoria semántica)
ML_ENABLED=true
# Si es true, EDITH activa Co-Working sola cuando la consulta es compleja
ML_AUTO_ROUTE=true
# Confianza mínima (0 a 1) para cambiar de ruta automáticamente
ML_AUTO_THRESHOLD=0.6
